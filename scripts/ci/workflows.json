{
  "version": 1,
  "workflows": {
    ".github/workflows/ci.yml": "35f12ec4d0bb542e2d158f96fe7f691508ff2b95c3e55a9700c6ccf5b69d9cce",
    ".github/workflows/release-candidate.yml": "f8d4936a252d6ee7badd956f0f592e2bc7fbcffd1174329d09eb06d9da92fdd3"
  },
  "profiles": {
    "pr": [
      "web",
      "julia",
      "debian-release-gate"
    ],
    "push": [
      "web",
      "julia"
    ],
    "release-candidate": [
      "release-candidate"
    ]
  },
  "jobs": {
    "web": {
      "workflow": ".github/workflows/ci.yml",
      "job": "web",
      "timeoutMinutes": 360,
      "commands": [
        "npm install",
        "npm run test:local-ci",
        "npm run validate:contracts",
        "npm run build",
        "npm run test",
        "npm run validate:control-doc-sync",
        "npm run validate:brd-traceability",
        "git diff --check"
      ]
    },
    "julia": {
      "workflow": ".github/workflows/ci.yml",
      "job": "julia",
      "timeoutMinutes": 360,
      "commands": [
        "julia --project=. -e 'using Pkg; Pkg.instantiate()'",
        "julia --project=. tests/julia/runtests.jl"
      ]
    },
    "debian-release-gate": {
      "workflow": ".github/workflows/ci.yml",
      "job": "debian-release-gate",
      "timeoutMinutes": 180,
      "commands": [
        "npm ci",
        "npx playwright install --with-deps chromium",
        "npm run verify:release"
      ]
    },
    "release-candidate": {
      "workflow": ".github/workflows/release-candidate.yml",
      "job": "debian-release-gate",
      "timeoutMinutes": 90,
      "commands": [
        "npm ci",
        "npx playwright install --with-deps chromium",
        "npm run verify:release"
      ]
    }
  },
  "images": {
    "ubuntu": "ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3",
    "node": "node:25.9.0-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370",
    "julia": "julia:1.12.7-bookworm@sha256:709daad7eccdb0363b080df203601988cff8c6a9581162668b76804cca407888",
    "postgres": "postgres:16-bookworm@sha256:efedf3595f1d6f415c08568ba171029bf54052e754cc9f030e3f2412b21f3d67"
  }
}
