{
  "name": "@juliaflow/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node -e \"const fs=require('node:fs');fs.rmSync('dist', { recursive: true, force: true });fs.mkdirSync('node_modules/.vite-temp', { recursive: true })\"",
    "predev": "node -e \"require('node:fs').mkdirSync('node_modules/.vite-temp', { recursive: true })\"",
    "pretest": "node -e \"require('node:fs').mkdirSync('node_modules/.vite-temp', { recursive: true })\"",
    "pretest:coverage": "node -e \"require('node:fs').mkdirSync('node_modules/.vite-temp', { recursive: true })\"",
    "build": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json && node ../../node_modules/vite/bin/vite.js build --configLoader runner",
    "dev": "node ../../node_modules/vite/bin/vite.js --configLoader runner",
    "preview": "node ../../node_modules/vite/bin/vite.js preview --configLoader runner",
    "test": "vitest run --configLoader runner",
    "test:coverage": "vitest run --coverage --configLoader runner"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@juliaflow/contracts": "file:../../packages/contracts",
    "@juliaflow/ui": "file:../../packages/ui",
    "@xyflow/react": "^12.11.0",
    "lucide-react": "^1.21.0",
    "plotly.js-dist-min": "^3.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^27.0.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.11"
  }
}
