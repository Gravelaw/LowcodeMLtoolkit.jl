{
  "version": "2.0",
  "channel": "workflow-realtime",
  "authentication": {
    "requiredIn": ["release", "local-appliance"],
    "httpHeader": "Authorization: Bearer <token>",
    "browserSubprotocols": ["juliaflow", "juliaflow.bearer.<base64url-utf8-token>"],
    "negotiatedSubprotocol": "juliaflow",
    "notes": "Expected Origin is checked before upgrade. Credentials are never placed in URLs or echoed in negotiated protocols. Each RPC rechecks permission and resource policy."
  },
  "methods": [
    {
      "name": "canvas.subscribe",
      "params": {
        "workflowId": "string"
      },
      "result": {
        "subscriptionId": "string"
      }
    },
    {
      "name": "workflow.execute",
      "params": {
        "workflowId": "string",
        "executionMode": "cpu_only | gpu_preferred | gpu_required"
      },
      "result": {
        "jobId": "string",
        "status": "accepted"
      }
    },
    {
      "name": "dashboard.subscribe",
      "params": {
        "dashboardId": "string",
        "outletIds": [
          "string"
        ]
      },
      "result": {
        "subscriptionId": "string"
      }
    }
  ],
  "events": [
    "workflow.state.changed",
    "node.state.changed",
    "execution.state.changed",
    "repository.save.changed",
    "dashboard.published",
    "dashboard.outlet.updated",
    "streaming.checkpoint.completed"
  ]
}
