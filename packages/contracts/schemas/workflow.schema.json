{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juliaflow.dev/schemas/workflow.schema.json",
  "title": "JuliaFlow WorkflowDefinition",
  "type": "object",
  "required": [
    "version",
    "workflow",
    "nodes",
    "connections"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "workflow": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "graph": {
          "type": "object",
          "required": [
            "revision",
            "node_layouts"
          ],
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "selected_node_id": {
              "type": "string"
            },
            "viewport": {
              "type": "object",
              "required": [
                "x",
                "y",
                "zoom"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "zoom": {
                  "type": "number"
                }
              }
            },
            "node_layouts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "node_id",
                  "x",
                  "y"
                ],
                "properties": {
                  "node_id": {
                    "type": "string"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number"
                  },
                  "checkpoint_tag": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "bi_outlets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "node_id",
              "name"
            ],
            "properties": {
              "node_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "dashboards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "binding",
              "charts"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "binding": {
                "type": "object",
                "required": [
                  "outlet_node_id",
                  "dataset_key",
                  "refresh_mode"
                ],
                "properties": {
                  "outlet_node_id": {
                    "type": "string"
                  },
                  "dataset_key": {
                    "type": "string"
                  },
                  "refresh_mode": {
                    "enum": [
                      "manual",
                      "live"
                    ]
                  }
                }
              },
              "charts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "title",
                    "family"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "family": {
                      "enum": [
                        "line",
                        "bar",
                        "area",
                        "table",
                        "metric"
                      ]
                    },
                    "x_field": {
                      "type": "string"
                    },
                    "y_field": {
                      "type": "string"
                    },
                    "series_field": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "node_ids"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "node_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "collapsed": {
                "type": "boolean"
              }
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "node_ids",
              "version",
              "flow_variable_scope"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "node_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "version": {
                "type": "string"
              },
              "flow_variable_scope": {
                "enum": [
                  "shared",
                  "isolated"
                ]
              },
              "dashboard_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "control_flow": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "loop",
                  "switch",
                  "try_catch",
                  "parallel_chunk"
                ]
              },
              "name": {
                "type": "string"
              },
              "start_node_id": {
                "type": "string"
              },
              "end_node_id": {
                "type": "string"
              },
              "iteration_mode": {
                "enum": [
                  "table_rows",
                  "files",
                  "parameter_range",
                  "streaming_batches"
                ]
              },
              "max_iterations": {
                "type": "integer",
                "minimum": 1
              },
              "selector": {
                "type": "string"
              },
              "cases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "case_id",
                    "label",
                    "target_node_id"
                  ],
                  "properties": {
                    "case_id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "target_node_id": {
                      "type": "string"
                    }
                  }
                }
              },
              "default_target_node_id": {
                "type": "string"
              },
              "try_node_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "catch_node_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source_node_id": {
                "type": "string"
              },
              "target_node_id": {
                "type": "string"
              },
              "chunk_size": {
                "type": "integer",
                "minimum": 1
              },
              "max_concurrency": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1024
              },
              "resource_class": {
                "enum": [
                  "cpu",
                  "gpu"
                ]
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "run_mode"
      ],
      "properties": {
        "run_mode": {
          "enum": [
            "batch",
            "stream"
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "kind",
            "topic",
            "consumer_group",
            "bootstrap_servers"
          ],
          "properties": {
            "kind": {
              "enum": [
                "kafka"
              ]
            },
            "topic": {
              "type": "string"
            },
            "consumer_group": {
              "type": "string"
            },
            "bootstrap_servers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "window": {
          "type": "object",
          "required": [
            "kind",
            "size_seconds"
          ],
          "properties": {
            "kind": {
              "enum": [
                "tumbling",
                "sliding"
              ]
            },
            "size_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "slide_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "policy": {
          "type": "object",
          "required": [
            "watermark_mode",
            "allowed_lateness_seconds",
            "max_in_flight_batches"
          ],
          "properties": {
            "watermark_mode": {
              "enum": [
                "processing_time",
                "event_time"
              ]
            },
            "allowed_lateness_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "max_in_flight_batches": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "flow_variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "String",
              "Integer",
              "Float64",
              "Bool",
              "DateTime",
              "GPUDeviceID"
            ]
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "execution_hint",
          "ports"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "execution_hint": {
            "enum": [
              "cpu_only",
              "gpu_preferred",
              "gpu_required"
            ]
          },
          "capabilities": {
            "type": "object",
            "required": [
              "execution_mode",
              "resource_class"
            ],
            "properties": {
              "execution_mode": {
                "enum": [
                  "batch",
                  "stream",
                  "hybrid"
                ]
              },
              "resource_class": {
                "enum": [
                  "cpu",
                  "gpu"
                ]
              },
              "accelerator": {
                "enum": [
                  "cuda"
                ]
              },
              "worker_pool": {
                "type": "string"
              }
            }
          },
          "gpu_device_preference": {
            "type": "string"
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "direction",
                "type"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "direction": {
                  "enum": [
                    "input",
                    "output"
                  ]
                },
                "type": {
                  "enum": [
                    "data_table",
                    "model",
                    "flow_variable",
                    "image",
                    "stream_channel",
                    "gpu_buffer"
                  ]
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "config": {
            "type": "object"
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_node_id",
          "source_port_id",
          "target_node_id",
          "target_port_id",
          "data_type"
        ],
        "properties": {
          "source_node_id": {
            "type": "string"
          },
          "source_port_id": {
            "type": "string"
          },
          "target_node_id": {
            "type": "string"
          },
          "target_port_id": {
            "type": "string"
          },
          "data_type": {
            "enum": [
              "data_table",
              "model",
              "flow_variable",
              "image",
              "stream_channel",
              "gpu_buffer"
            ]
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  }
}
