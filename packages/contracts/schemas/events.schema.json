{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juliaflow.dev/schemas/events.schema.json",
  "title": "JuliaFlow Event Contracts",
  "type": "object",
  "required": [
    "durableEvent"
  ],
  "properties": {
    "durableEvent": {
      "type": "object",
      "required": [
        "eventId",
        "eventType",
        "aggregateType",
        "aggregateId",
        "occurredAt",
        "sequence",
        "producer",
        "payloadVersion",
        "payload"
      ],
      "properties": {
        "eventId": {
          "type": "string"
        },
        "eventType": {
          "enum": [
            "execution.changed",
            "stream.checkpoint.completed",
            "repository.save.changed",
            "hub.extension.changed",
            "dashboard.published",
            "audit.action"
          ]
        },
        "aggregateType": {
          "type": "string"
        },
        "aggregateId": {
          "type": "string"
        },
        "occurredAt": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "producer": {
          "type": "string"
        },
        "payloadVersion": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "executionId",
                "workflowId",
                "workflowVersion",
                "status"
              ],
              "properties": {
                "executionId": { "type": "string" },
                "workflowId": { "type": "string" },
                "workflowVersion": { "type": "string" },
                "status": { "type": "string" }
              }
            },
            {
              "type": "object",
              "required": [
                "workflowId",
                "checkpointId",
                "offsets",
                "stateVersion"
              ],
              "properties": {
                "workflowId": { "type": "string" },
                "checkpointId": { "type": "string" },
                "offsets": { "type": "object" },
                "stateVersion": { "type": "integer" }
              }
            },
            {
              "type": "object",
              "required": [
                "workflowId",
                "workflowVersion",
                "savedAt"
              ],
              "properties": {
                "workflowId": { "type": "string" },
                "workflowVersion": { "type": "string" },
                "graphRevision": { "type": "integer" },
                "savedAt": { "type": "string" }
              }
            },
            {
              "type": "object",
              "required": [
                "extensionId",
                "manifest",
                "installState"
              ],
              "properties": {
                "extensionId": { "type": "string" },
                "manifest": { "type": "object" },
                "installState": { "type": "string" }
              }
            },
            {
              "type": "object",
              "required": [
                "dashboardId",
                "workflowId",
                "name",
                "version",
                "publishedAt",
                "visibility",
                "binding",
                "charts"
              ],
              "properties": {
                "dashboardId": { "type": "string" },
                "workflowId": { "type": "string" },
                "name": { "type": "string" },
                "version": { "type": "integer" },
                "publishedAt": { "type": "string" },
                "visibility": {
                  "enum": ["workspace", "public"]
                },
                "shareToken": { "type": "string" },
                "binding": { "type": "object" },
                "charts": { "type": "array" }
              }
            },
            {
              "type": "object",
              "required": [
                "action",
                "targetType",
                "targetId",
                "recordedAt",
                "authContext",
                "details"
              ],
              "properties": {
                "action": { "type": "string" },
                "targetType": { "type": "string" },
                "targetId": { "type": "string" },
                "recordedAt": { "type": "string" },
                "authContext": {
                  "type": "object",
                  "required": [
                    "principalId",
                    "workspaceId",
                    "role",
                    "mode",
                    "permissions"
                  ],
                  "properties": {
                    "principalId": { "type": "string" },
                    "workspaceId": { "type": "string" },
                    "role": { "type": "string" },
                    "mode": { "type": "string" },
                    "permissions": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                },
                "details": { "type": "object" }
              }
            }
          ]
        }
      }
    }
  }
}
