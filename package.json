{
  "name": "juliaflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-workspaces.mjs",
    "dev:frontend": "npm --workspace @juliaflow/frontend run dev",
    "dev:local": "node scripts/dev-local.mjs",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "smoke:live-backend-browser": "node scripts/smoke-live-backend-browser.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test": "npm run test --workspaces --if-present && node --test tests/contracts/**/*.test.mjs",
    "validate:contracts": "node --test tests/contracts/**/*.test.mjs",
    "validate:brd-traceability": "node scripts/validate-brd-traceability.mjs",
    "perf:render": "node scripts/perf-render-harness.mjs",
    "perf:dispatch": "node scripts/run-julia.mjs --project=. scripts/bench-dispatch.jl",
    "validate:perf": "npm run perf:render && npm run perf:dispatch",
    "validate:coverage": "npm --workspace @juliaflow/frontend run test:coverage && npm run validate:coverage:surface",
    "validate:coverage:surface": "node scripts/coverage-surface-gate.mjs",
    "validate:p1": "npm run validate:perf && npm run validate:coverage && npm run validate:brd-traceability",
    "validate:k8s": "bash scripts/validate-k8s-manifests.sh",
    "smoke:local-bootstrap": "node scripts/smoke-local-bootstrap.mjs",
    "smoke:local-data-estate": "node scripts/smoke-local-data-estate.mjs",
    "validate:control-doc-sync": "node scripts/validate-control-doc-sync.mjs",
    "preinstall": "node scripts/ensure-debian-toolchain.mjs",
    "prebuild": "node scripts/ensure-debian-toolchain.mjs",
    "pretest": "node scripts/ensure-debian-toolchain.mjs",
    "doctor:debian": "node scripts/ensure-debian-toolchain.mjs --julia && node -p \"process.platform + ' ' + process.execPath\" && npm --version && npx --version",
    "doctor:windows": "node scripts/ensure-debian-toolchain.mjs --julia && node -p \"process.platform + ' ' + process.execPath\" && npm --version && npx --version",
    "doctor:wsl-node": "npm run doctor:debian",
    "julia:instantiate": "node scripts/run-julia.mjs --compiled-modules=no --project=. -e \"using Pkg; Pkg.instantiate()\"",
    "julia:test": "node scripts/run-julia.mjs --compiled-modules=no --project=. tests/julia/runtests.jl",
    "julia:test:timed": "node scripts/time-julia-runtests.mjs",
    "julia:test:presentation": "node scripts/time-julia-runtests.mjs --slice=presentation",
    "julia:test:helpers": "node scripts/time-julia-runtests.mjs --slice=helpers",
    "julia:test:tuning": "node scripts/time-julia-runtests.mjs --slice=tuning",
    "julia:test:project-contracts": "node scripts/time-julia-runtests.mjs --slice=project-contracts",
    "julia:test:project-evidence": "node scripts/time-julia-runtests.mjs --slice=project-evidence",
    "julia:test:local-sources": "node scripts/time-julia-runtests.mjs --slice=local-sources",
    "julia:test:repository": "node scripts/time-julia-runtests.mjs --slice=repository",
    "julia:test:worker": "node scripts/time-julia-runtests.mjs --slice=worker",
    "julia:test:api-gateway": "node scripts/time-julia-runtests.mjs --slice=api-gateway",
    "smoke:local-metadata": "node scripts/smoke-local-metadata.mjs",
    "smoke:local-hardware": "node scripts/smoke-local-hardware.mjs",
    "smoke:local-explainability": "node scripts/dev-local.mjs --profile single-user --smoke --no-deps",
    "smoke:local-offline-hub": "node scripts/smoke-local-offline-hub.mjs",
    "smoke:local-reproducibility": "node scripts/smoke-local-reproducibility.mjs",
    "smoke:local-migration": "node scripts/smoke-local-migration.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "typescript": "^5.9.3"
  }
}
